ARG BASE=hermes-agent:latest
FROM ${BASE}

USER root

# TeX (xelatex + CJK) so the agent can compile Markdown / 数据 → PDF reports,
# including Chinese. Debian has no "BasicTeX" (that's the MacTeX name); this is
# the closest usable set. xelatex + texlive-lang-chinese + fonts-noto-cjk cover
# ctex/xeCJK Chinese typesetting; latexmk is the common compile driver.
RUN apt-get update && apt-get install -y --no-install-recommends \
        texlive-latex-base texlive-latex-recommended texlive-xetex \
        texlive-fonts-recommended texlive-lang-chinese \
        fonts-noto-cjk latexmk \
    && rm -rf /var/lib/apt/lists/* \
    && xelatex --version > /dev/null

# Preinstall common data-analysis / ML / web-parsing packages into the
# hermes venv. The agent's execute_code sandbox and terminal `python3`
# both resolve to /opt/hermes/.venv/bin/python3, so installing here makes
# the packages visible to tools without needing pip at runtime.
RUN VIRTUAL_ENV=/opt/hermes/.venv uv pip install --no-cache \
    pandas openpyxl xlrd matplotlib scipy \
    beautifulsoup4 lxml \
    scikit-learn pyarrow tqdm \
    python-pptx markitdown yfinance \
    ddgs requests

# /etc/profile unconditionally resets PATH, which strips /opt/hermes/.venv/bin
# when hermes' terminal tool spawns `bash -l` (login shell) to snapshot the
# environment. Without the venv on PATH the captured snapshot points at the
# system python (no pandas/openpyxl/etc), so every subsequent terminal command
# from the agent fails to import preinstalled packages. Re-prepend the venv
# from a profile.d drop-in so login shells see the same PATH as hermes itself.
RUN printf 'export PATH=/opt/hermes/.venv/bin:$PATH\nexport NODE_PATH=/opt/hermes/node_modules\n' > /etc/profile.d/hermes-venv.sh

COPY oneshot.py /opt/hermes-eval/oneshot.py
RUN chmod +x /opt/hermes-eval/oneshot.py

# Headless-Chrome fetcher. playwright + chromium-headless-shell + the stealth
# plugin already ship in the hermes base under /opt/hermes/node_modules, but the
# agent's terminal runs from /workspace, where `require()` can't resolve them.
# NODE_PATH (set below + in the profile.d drop-in) fixes resolution; scrape.js
# gives the agent a one-shot `node /opt/hermes-eval/scrape.js <url>` to render
# JS-heavy pages that a plain HTTP GET / ddgs can't.
COPY scrape.js /opt/hermes-eval/scrape.js
RUN chmod +x /opt/hermes-eval/scrape.js

# Disable the upstream entrypoint's privilege drop (`exec gosu hermes`)
# so the agent runs as root. Tasks can then apt-get / uv pip install
# runtime deps without permission errors. oneshot.py chowns the bind
# mounts back to HERMES_UID/HERMES_GID on exit so host files stay owned
# by the invoking user.
RUN sed -i 's|exec gosu hermes "$0" "$@"|: # priv-drop disabled for hermes-eval|' \
    /opt/hermes/docker/entrypoint.sh

ENV TERMINAL_ENV=local
ENV HERMES_HOME=/opt/data
ENV PYTHONUNBUFFERED=1
ENV NODE_PATH=/opt/hermes/node_modules
